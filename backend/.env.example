PORT=4000
MONGO_URI=mongodb://localhost:27017/halyk_pay

# Public address of this API: Halyk posts the payment notification here.
PUBLIC_API_URL=http://localhost:4000
# Where the customer-facing pages live. In development that is the Vite server (5173).
# In production the backend serves the built frontend, so use the same address as PUBLIC_API_URL.
FRONTEND_URL=http://localhost:5173

# Placeholder price, change it to your real one
PREMIUM_PRICE_KZT=2990
PREMIUM_DAYS=30

# mock = built-in Halyk simulator (no credentials, works offline)
# test = Halyk ePay test environment (needs test credentials)
# prod = real payments
HALYK_ENV=mock
HALYK_CLIENT_ID=test
HALYK_CLIENT_SECRET=
HALYK_TERMINAL=
HALYK_POSTLINK_SECRET=
